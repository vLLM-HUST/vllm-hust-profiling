#!/usr/bin/env bash

export PROFILING_ROOT="${PROFILING_ROOT:-/workspace/vllm-hust-profiling}"
export VLLM_ROOT="${VLLM_ROOT:-/workspace/vllm-hust}"
export VLLM_ASCEND_ROOT="${VLLM_ASCEND_ROOT:-/workspace/vllm-ascend-hust}"
export BENCHMARK_ROOT="${BENCHMARK_ROOT:-/workspace/vllm-hust-benchmark}"

export HF_CACHE_ROOT="${HF_CACHE_ROOT:-/root/.cache/huggingface/hub}"

find_hf_snapshot() {
    local cache_name="$1"
    local fallback="$2"
    local cache_dir="$HF_CACHE_ROOT/$cache_name"
    local ref_file="$cache_dir/refs/main"
    local ref
    local snapshot

    if [[ -f "$ref_file" ]]; then
        ref="$(<"$ref_file")"
        snapshot="$cache_dir/snapshots/$ref"
        if [[ -f "$snapshot/config.json" ]]; then
            printf '%s\n' "$snapshot"
            return 0
        fi
    fi

    snapshot="$(find "$cache_dir/snapshots" -mindepth 1 -maxdepth 1 \
        -type d -exec test -f '{}/config.json' \; -print 2>/dev/null | sort | tail -n 1)"
    printf '%s\n' "${snapshot:-$fallback}"
}

if [[ -z "${MODEL_14B:-}" ]]; then
    export MODEL_14B="$(find_hf_snapshot \
        models--Qwen--Qwen2.5-14B-Instruct /workspace/models/Qwen2.5-14B-Instruct)"
else
    export MODEL_14B
fi
if [[ -z "${MODEL_7B:-}" ]]; then
    export MODEL_7B="$(find_hf_snapshot \
        models--Qwen--Qwen2.5-7B-Instruct /workspace/models/Qwen2.5-7B-Instruct)"
else
    export MODEL_7B
fi
export AGENT_DATASET="${AGENT_DATASET:-$BENCHMARK_ROOT/scripts/traces/evoscientist-workload-custom.jsonl}"
export SHAREGPT_DATASET=${SHAREGPT_DATASET:-/workspace/datasets/ShareGPT_V3_unfiltered_cleaned_split.json}
