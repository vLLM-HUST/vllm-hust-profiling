# G0 smoke: reuse-heavy prefix replay. The caller supplies a bursty request
# rate; this file changes no admission or release policy.
SCENARIO_FILTER=kv-tiering-prefix-online
MODE_FILTER=true
KV_PREFIX_PROMPTS=64
RANDOM_REQUEST_RATE=8
PREFIX_LEN=3840
PREFIX_SUFFIX_LEN=256
PREFIX_NUM_PREFIXES=2
# Required for a real G0 run. The MMC meta service must already be running;
# this is telemetry-only configuration, not a wave-shaping policy.
G0_VLLM_ASCEND_ROOT=/root/g0-vllm-ascend
G0_VLLM_ASCEND_NATIVE_ROOT=/vllm-workspace/vllm-ascend
G0_KV_TRANSFER_CONFIG='{"kv_connector":"AscendStoreConnector","kv_role":"kv_both","kv_connector_extra_config":{"backend":"memcache","use_layerwise":true,"layerwise_prefetch_layers":1}}'
G0_REQUIRE_TELEMETRY=1
